{
  "private": true,
  "type": "module",
  "name": "watch-duty-manager",
  "imports": {
    "#prisma/client": "./prisma/generated/client.ts"
  },
  "description": "",
  "license": "",
  "scripts": {
    "build": "prisma generate && react-router build",
    "check": "biome check --write ./app && npm run check:depcruise",
    "check:depcruise": "depcruise app --config .dependency-cruiser.cjs",
    "dev": "node -r dotenv/config node_modules/.bin/react-router dev --host 0.0.0.0",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "db:setup": "npx prisma db push && npx prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "test": "SECRET=test-secret vitest run",
    "test:integration": ". ./.env.test && npx prisma db push --accept-data-loss > /dev/null 2>&1 && npx vitest run --config vite.integration.mts",
    "test:tsc": "react-router typegen && tsc --noEmit --incremental",
    "test:tsc:watch": "tsc --noEmit --watch --incremental"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.0.0",
    "isbot": "^5.2.1",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-multi-date-picker": "^4.5.2",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "temporal-polyfill": "^0.3.0",
    "url-from": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dependency-cruiser": "^17.4.2",
    "esbuild-register": "^3.6.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-cjs-interop": "^4.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --write --no-errors-on-unmatched"
  },
  "sideEffects": false
}
